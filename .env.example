TO_EMAIL=your@email.com
SMTP_USER=your_sending_account@gmail.com
SMTP_PASS=your_gmail_app_password

# Optional: Discord webhook URL to also post alerts to a channel.
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
# Leave blank to skip Discord notifications.
DISCORD_WEBHOOK_URL=

# --- Historical trends feature ---

# Optional: Acartia API token, once your registration is approved (passed
# as an access_token query parameter, not a Bearer header -- see
# ingestion/acartia_client.py).
# Leave blank to use the unauthenticated /sightings/current endpoint only.
ACARTIA_API_TOKEN=

# Optional: separate Discord BOT token (not the webhook above) for the
# /whales slash command -- needs its own bot application with the
# applications.commands scope, invited to the server alongside the
# existing webhook. See discord_bot/whale_command.py.
DISCORD_BOT_TOKEN=

# Optional: override the push-alert geographic gate (alerts/geo_filter.py).
# Defaults to West Seattle, ~8mi radius (covering Alki Point, Emma
# Schmitz Overlook, Lincoln Park) if left unset.
ALERT_CENTER_LAT=
ALERT_CENTER_LON=
ALERT_RADIUS_MILES=

